                    "#": 41,
                    "Msg": "Хорошо",
                    "AMsg.Num": "5"
                },
                {
                    "Type": "TDialogAnswer",
                    "Name": "restart",
                    "Pos.x": 720,
                    "Pos.y": 465,
                    "Parent": -1,
                    "#": 42,
                    "Msg": "До свидания",
                    "AMsg.Num": "6"
                },
                {
                    "Type": "TDialogAnswer",
                    "Name": "",
                    "Pos.x": 840,
                    "Pos.y": 465,
                    "Parent": -1,
                    "#": 43,
                    "Msg": "Слушайте, а вы меня заинтересовали. Так, что там за проект такой и сколько это будет стоить?",
                    "AMsg.Num": "7"
                },
                {
                    "Type": "TDialogAnswer",
                    "Name": "",
                    "Pos.x": 960,
                    "Pos.y": 465,
                    "Parent": -1,
                    "#": 44,
                    "Msg": "Я с радостью помогу вам, ведь уникальные вещи это то, ради чего стоить жить!",
                    "AMsg.Num": "8"
                },
                {
                    "Type": "TDialogAnswer",
