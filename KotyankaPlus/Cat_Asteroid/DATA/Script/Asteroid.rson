                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 60,
                    "Pos.y": 510,
                    "Parent": -1,
                    "#": 18,
                    "Code.Type": "Init",
                    "Code": 
                    [
                        "good_special_name = CT('Script.Asteroid.Settings.good_special_name');",
                        "",
                        "hull_cost_1 = CT('Script.Asteroid.Settings.hull_cost_1');",
                        "",
                        "hull_size_good = CT('Script.Asteroid.Settings.hull_size_good');",
                        "",
                        "research_time_fast = CT('Script.Asteroid.Settings.research_time_fast');"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 120,
                    "Pos.y": 510,
                    "Parent": -1,
                    "#": 19,
                    "Code.Type": "Turn",
                    "Code": 
                    [
                        "if(state == 1) {",
                        "  if(CurTurn() >= research_start_date + research_time) {",
                        "    if(IdToShip(base_id)) {",
                        "      Ether(0, '', \"База <base_name> завершила постройку и исследования, можете прилетать!\");",
                        "      state = 2;",
                        "    }",
                        "  }",
                        "  if(!IdToShip(base_id)) {",
                        "    Ether(0, '', \"База <base_name> была уничтожена, как и ваши инвестиции в проект...\");",
                        "    state = -1;",
                        "  }",
                        "}"
                    ]
                },
                {
                    "Type": "Top",
                    "Name": "",
                    "Pos.x": 180,
                    "Pos.y": 510,
                    "Parent": -1,
                    "#": 20,
                    "Code.Type": "DialogBegin",
                    "Code": 
                    [
                        "if(!PlayerBridge()) {",
                        "  if(GetShipRuins(Player())) {",
                        "    if(state == 0) {",
                        "      if(ShipType(GetShipRuins(Player())) == 'TC') {",
                        "        AddDialogInject('DialogTC1', '', \"Здравствуйте, я бы хотел поинтересоваться, нет ли у вас сейчас каких-либо проектов, где могла бы пригодиться помощь рейнджера?\", 1);",
                        "      }",
                        "    }",
                        "    if(state == 1) {",
                        "      if(Id(GetShipRuins(Player())) == base_id) {",
                        "        AddDialogInject('DialogTC1.5', '', \"Я вот тут вернулся узнать - что там с тем проектом, который я спонсировал?\", 1);",
                        "      }",
                        "      if(Id(GetShipRuins(Player())) != base_id) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'TC') {",
                        "          AddDialogInject('WrongBase1.5', '', \"Я вот тут вернулся узнать - что там с тем проектом, который я спонсировал?\", 1);",
                        "        }",
                        "      }",
                        "    }",
                        "    if(state == 2) {",
                        "      if(Id(GetShipRuins(Player())) == base_id) {",
                        "        AddDialogInject('DialogTC2', '', \"Я вот тут вернулся узнать - что там с тем проектом, который я спонсировал?\", 1);",
                        "      }",
                        "      if(Id(GetShipRuins(Player())) != base_id) {",
                        "        if(ShipType(GetShipRuins(Player())) == 'TC') {",
                        "          AddDialogInject('WrongBase2', '', \"Я вот тут вернулся узнать - что там с тем проектом, который я спонсировал?\", 1);",
                        "        }",
                        "      }",
                        "    }",
                        "  }",
                        "}"
                    ]
                },
