                    "Parent": -1,
                    "#": 17,
                    "Code.Type": "Global",
                    "Code": 
                    [
                        "if(IsScriptActive('Mod_ExpPhysGun_AfterQuestDone')) {",
                        "  if(GalaxyTechLevel() >= 7) {",
                        "    GRun();",
